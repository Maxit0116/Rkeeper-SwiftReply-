page {
  background-color: #0f0f1a;
  color: #eee;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
}

.container {
  padding: 20rpx 30rpx;
}

.card {
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}

.btn-primary {
  background: linear-gradient(135deg, #e94560, #ff6b6b);
  color: white;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-weight: 600;
  border: none;
}

.btn-secondary {
  background: #2d2d44;
  color: #ccc;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  border: 1rpx solid #3d3d5c;
}

.tag {
  display: inline-block;
  background: #2d2d44;
  color: #ccc;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag.active {
  background: #e94560;
  color: white;
}

.input {
  background: #2d2d44;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #eee;
  font-size: 28rpx;
  border: 1rpx solid #3d3d5c;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #fff;
}

.reply-item {
  background: #2d2d44;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #e94560;
}

.slogan {
  text-align: center;
  color: #888;
  font-size: 26rpx;
  margin-top: 10rpx;
}
