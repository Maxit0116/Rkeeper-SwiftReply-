<view class="container">
  <view class="card" style="text-align:center;">
    <text class="section-title">👥 我的关系画像</text>
    <text style="color:#888; font-size:24rpx; display:block; margin-bottom:20rpx;">
      管理你的社交关系，让 AI 更懂你
    </text>
    <button class="btn-primary" bindtap="addProfile" style="width:100%;">+ 新建关系画像</button>
  </view>

  <view wx:for="{{profiles}}" wx:key="id" class="card profile-card" bindtap="editProfile" data-id="{{item.id}}">
    <view style="display:flex; align-items:center;">
      <text style="font-size:56rpx; margin-right:24rpx;">{{item.emoji}}</text>
      <view style="flex:1;">
        <text style="font-weight:700; font-size:32rpx; color:#fff; display:block;">{{item.nickname}}</text>
        <text style="color:#888; font-size:24rpx;">{{item.subCategory || item.category}} · {{item.currentGoal || '未设目标'}}</text>
      </view>
      <text style="color:#e94560; font-size:40rpx;">›</text>
    </view>
    <view wx:if="{{item.energyLevel}}" style="margin-top:16rpx;">
      <text class="tag">{{item.energyLevel}}</text>
    </view>
  </view>

  <view wx:if="{{profiles.length === 0}}" style="text-align:center; padding:80rpx 40rpx;">
    <text style="color:#666; font-size:28rpx;">暂无关系画像
点击上方按钮创建</text>
  </view>
</view>
