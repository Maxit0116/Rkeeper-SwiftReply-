<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0f0f1a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="没电键盘设置"
        android:textColor="#fff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前社交目标"
        android:textColor="#888"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinner_goal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#2d2d44"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前电量状态"
        android:textColor="#888"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinner_energy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#2d2d44"
        android:layout_marginBottom="32dp" />

    <!-- Accessibility Service Section -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2d2d44"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔮 自动读取聊天上下文"
        android:textColor="#fff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_a11y_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="状态：未开启"
        android:textColor="#888"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_a11y"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="开启辅助服务"
        android:textColor="#fff"
        android:backgroundTint="#e94560"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提示：开启后，输入法可以自动读取微信聊天内容作为AI上下文。需要系统无障碍权限。"
        android:textColor="#666"
        android:textSize="12sp"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2d2d44"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="保存设置"
        android:textColor="#fff"
        android:backgroundTint="#4CAF50"
        android:textSize="16sp" />
</LinearLayout>
